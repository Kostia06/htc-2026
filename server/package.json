{
  "name": "htc-mentor-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply htc_mentor --local",
    "db:migrate:remote": "wrangler d1 migrations apply htc_mentor --remote",
    "db:translate": "node scripts/sqlite-to-postgres.mjs",
    "db:copy-to-supabase": "node scripts/copy-d1-to-supabase.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "postgres": "3.4.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
