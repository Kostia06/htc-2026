# Copy to web/.env.local. Public values only: the publishable key is meant for browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Worker that /api is proxied to in dev. Defaults to http://localhost:8787
API_PROXY_TARGET=

# Optional: where the built app calls the API. Defaults to https://api.skillit.study in a build, the /api proxy in dev
VITE_API_BASE=
# Optional: the path the app is served under. Defaults to / in a build, /app/ in dev
APP_BASE=
