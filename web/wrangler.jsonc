// Static site on Cloudflare, served at its skillit.study address. Deploy: npm run build, then npx wrangler deploy.
{
  "$schema": "../server/node_modules/wrangler/config-schema.json",
  "name": "skillit-web",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "app.skillit.study", "custom_domain": true }]
}
