# Worker secrets. Set with `wrangler secret put <NAME>` (remote) or in server/.dev.vars (local).
# Never in the web bundle or the iOS app.
GEMINI_API_KEY=
KEENABLE_API_KEY=
SESSION_SECRET=
MEMORY_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Supabase project URL (Project Settings > API), e.g. https://abcd1234.supabase.co.
# Not secret: the server only reads public signing keys from it. Unset = sign-in off.
SUPABASE_URL=

# voice practice: gemini (default) or elevenlabs
VOICE_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
